{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:cr_he": "playwright test --headed --project=chromiun",
    "test:demo": "cross-env ENV_NAME=demo playwright test",
    "test:qa": "cross-env ENV_NAME=qa playwright test",
    "test:demo_cr_he": "cross-env ENV_NAME=demo playwright test --headed --project=chromium",
    "test:qa_cr_he": "cross-env ENV_NAME=qa playwright test --headed --project=chromium",
    "clean:allure": "rimraf allure-results allure-report",
    "test:allure": "npm run clean:allure && npx playwright test",
    "report:allure": "npx allure serve allure-results",
    "generate:allure": "allure generate allure-results --clean -o allure-report"
    
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure": "^3.6.2",
    "allure-commandline": "^2.32.2",
    "allure-playwright": "^3.7.1",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2"
  }
}